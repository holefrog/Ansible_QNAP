---
# 请复制本文件为 secrets.yml，并填入您的真实密码。
# 强烈建议使用 ansible-vault 对 secrets.yml 进行加密：
# ansible-vault encrypt secrets.yml

vault_qnap_user: 'admin'
vault_qnap_password: 'your_qnap_password'

vault_mariadb_root_password: 'your_mariadb_root_password'
vault_mariadb_user_password: 'your_mariadb_user_password'

